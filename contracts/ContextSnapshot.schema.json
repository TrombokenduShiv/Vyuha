{
  "title": "ContextSnapshot",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp_ms": {
      "type": "integer"
    },
    "transaction": {
      "type": "object",
      "properties": {
        "amount_bucket": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "beneficiary_novelty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "channel": {
          "type": "string"
        },
        "online_purchase": {
          "type": "boolean"
        },
        "independently_verified": {
          "type": "boolean"
        },
        "beneficiary_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "amount_bucket",
        "beneficiary_novelty",
        "channel"
      ]
    },
    "communication": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "active": {
          "type": "boolean"
        }
      },
      "required": [
        "active"
      ]
    },
    "device": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "capture_risk": {
          "type": "boolean"
        },
        "overlay_risk": {
          "type": "boolean"
        }
      },
      "required": [
        "capture_risk",
        "overlay_risk"
      ]
    },
    "baseline": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "deviation_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "deviation_score"
      ]
    },
    "graph_risk_token": {
      "anyOf": [
        {
          "$ref": "GraphRiskToken.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "session_id",
    "timestamp_ms",
    "transaction",
    "communication",
    "device",
    "baseline"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
