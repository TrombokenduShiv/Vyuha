      "format": "uuid"
    },
    "timestamp_ms": {
      "type": "integer"
    },
    "escalation_level": {
      "type": "string",
      "enum": [
        "PRIMARY",
        "SECONDARY",
        "BANK_FRAUD_DESK"
      ]
    },
    "message_template_id": {
      "type": "string"
    },
    "status": {
