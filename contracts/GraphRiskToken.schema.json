{
  "": "http://json-schema.org/draft-07/schema#",
  "title": "GraphRiskToken",
  "type": "object",
  "properties": {
    "vpa_hash": {
      "type": "string"
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issued_at": {
      "type": "integer"
    },
    "expires_at": {
      "type": "integer"
    },
    "model_version": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    }
  },
  "required": [
    "vpa_hash",
    "risk_score",
    "confidence",
    "reason_codes",
    "issued_at",
    "expires_at",
    "signature"
  ]
}